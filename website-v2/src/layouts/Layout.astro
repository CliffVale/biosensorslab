---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.labName}` : `${SITE.labName} - ${SITE.university}`;

// Dynamic OG Image mapping
const currentPath = Astro.url.pathname.replace(/^\/|\/$/g, '');
const ogSlug = currentPath === '' ? 'index' : currentPath;
const supportedOgPages = ['index', 'research', 'publications', 'patents', 'equipment', 'team', 'news', 'join'];
const finalOgSlug = supportedOgPages.includes(ogSlug) ? ogSlug : 'index';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${basePath}/og/${finalOgSlug}.png`, Astro.url);
// Base-path-aware home detection (pathname === '/' never matches when a base is set)
const pathNoBase = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/').replace(/\/+$/, '') || '/';
const isHome = pathNoBase === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self';" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#047857" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={basePath + '/favicon.svg'} />
    <link rel="icon" type="image/png" sizes="32x32" href={basePath + '/favicon.png'} />
    <link rel="apple-touch-icon" href={basePath + '/favicon.png'} />
    <link rel="icon" type="image/x-icon" href={basePath + '/favicon.ico'} />
    <link rel="manifest" href={basePath + '/manifest.json'} />
    <link rel="preload" href={basePath + '/fonts/Inter-Variable.woff2'} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.labName} — ${SITE.university}`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    {
      isHome && (
        <>
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "ResearchOrganization",
          "name": SITE.labName,
          "url": SITE.website,
          "logo": new URL(basePath + SITE.logo, SITE.website).href,
          "description": SITE.description,
          "parentOrganization": {
            "@type": "CollegeOrDepartment",
            "name": "Centre for Biomedical Engineering (CBME)",
            "parentOrganization": {
              "@type": "CollegeOrUniversity",
              "name": "Indian Institute of Technology Delhi",
              "url": "https://iitd.ac.in/"
            }
          },
          "email": SITE.email,
          "member": {
            "@type": "Person",
            "name": SITE.author,
            "jobTitle": "Principal Investigator",
            "worksFor": {
              "@type": "ResearchOrganization",
              "name": SITE.labName,
              "url": SITE.website
            }
          }
        })} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Person",
          "name": SITE.author,
          "url": SITE.website,
          "jobTitle": "Principal Investigator",
          "worksFor": {
            "@type": "ResearchOrganization",
            "name": SITE.labName,
            "url": SITE.website
          },
          "description": SITE.description
        })} />
        </>
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-grow" data-pagefind-body>
      <slot />
    </main>

    <footer class="mt-16 bg-strip-dark text-gray-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid gap-10 md:grid-cols-12">
          <!-- Brand + address -->
          <div class="md:col-span-5">
            <p class="text-white font-semibold">{SITE.labName}</p>
            <p class="text-sm mt-1 text-emerald-200/90">{SITE.university} · Centre for Biomedical Engineering</p>
            <p class="text-sm mt-4 leading-relaxed text-gray-400">
              Room GPL-9 (lab relocating), Indian Institute of Technology Delhi,<br />
              Hauz Khas, New Delhi 110016, India
            </p>
            <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-2 mt-3 text-sm text-emerald-300 hover:text-emerald-200 transition-colors">
              {SITE.email}
            </a>
          </div>
          <!-- Explore -->
          <div class="md:col-span-4">
            <p class="text-sm font-semibold text-white mb-3">Explore</p>
            <div class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
              <a href={basePath + "/research"} class="text-gray-400 hover:text-white transition-colors">Research</a>
              <a href={basePath + "/publications"} class="text-gray-400 hover:text-white transition-colors">Publications</a>
              <a href={basePath + "/team"} class="text-gray-400 hover:text-white transition-colors">Team</a>
              <a href={basePath + "/patents"} class="text-gray-400 hover:text-white transition-colors">Patents</a>
              <a href={basePath + "/equipment"} class="text-gray-400 hover:text-white transition-colors">Equipment</a>
              <a href={basePath + "/gallery"} class="text-gray-400 hover:text-white transition-colors">Gallery</a>
              <a href={basePath + "/news"} class="text-gray-400 hover:text-white transition-colors">News</a>
              <a href={basePath + "/funding"} class="text-gray-400 hover:text-white transition-colors">Funding</a>
            </div>
          </div>
          <!-- Prospectives -->
          <div class="md:col-span-3">
            <p class="text-sm font-semibold text-white mb-3">Prospective members</p>
            <div class="flex flex-col gap-2 text-sm">
              <a href={basePath + "/contact#join"} class="text-gray-400 hover:text-white transition-colors">Join the lab</a>
              <a href={basePath + "/courses"} class="text-gray-400 hover:text-white transition-colors">Courses</a>
              <a href={basePath + "/contact"} class="text-gray-400 hover:text-white transition-colors">Contact</a>
              <a href={basePath + "/search"} class="text-gray-400 hover:text-white transition-colors">Search</a>
            </div>
          </div>
        </div>
        <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-500">
          <p>© {new Date().getFullYear()} {SITE.labName}. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <!-- Scroll-reveal driver: adds .is-visible to [data-reveal] as they enter the viewport.
         No-op when JS is unavailable or reduced-motion is preferred (CSS guard handles both). -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        if (
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !('IntersectionObserver' in window)
        ) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                en.target.classList.add('is-visible');
                io.unobserve(en.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -32px 0px' }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>