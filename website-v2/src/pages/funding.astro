---
import Layout from '../layouts/Layout.astro';
import { Landmark, ExternalLink, Award } from 'lucide-react';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const logos = {
  icmr: basePath + '/funding-logos/icmr-logo.svg',
  dbt: basePath + '/funding-logos/dbt-logo.png',
  dhr: basePath + '/funding-logos/dhr-logo.jpg',
  bc: basePath + '/funding-logos/bc-logo.svg',
  iitd: basePath + '/funding-logos/iitd-official-logo.png',
  anrf: basePath + '/funding-logos/anrf-logo.png',
};

const agencies = [
  {
    name: 'Indian Council of Medical Research (ICMR)',
    logo: logos.icmr,
    url: 'https://www.icmr.gov.in/',
    desc: 'The apex body in India for the formulation, coordination and promotion of biomedical research.',
  },
  {
    name: 'Department of Biotechnology (DBT)',
    logo: logos.dbt,
    url: 'https://dbtindia.gov.in/',
    desc: 'Promotes research, education and entrepreneurship in modern biology and biotechnology.',
  },
  {
    name: 'Anusandhan National Research Foundation (ANRF)',
    logo: logos.anrf,
    url: 'https://anrfonline.in/',
    desc: 'India\'s apex research funding agency for promoting high-quality science and technology research.',
  },
  {
    name: 'Department of Health Research (ICMR-DHR)',
    logo: logos.dhr,
    url: 'https://dhr.gov.in/',
    desc: 'Supports health research, human resource development in health research and research infrastructure.',
  },
  {
    name: 'British Council',
    logo: logos.bc,
    url: 'https://www.britishcouncil.org/',
    desc: 'The UK\'s international organisation for cultural relations and educational opportunities.',
  },
  {
    name: 'Indian Institute of Technology Delhi (IIT Delhi)',
    logo: logos.iitd,
    url: 'https://home.iitd.ac.in/',
    desc: 'Institutional support for research infrastructure and graduate education.',
  },
];
---

<Layout
  title="Funding"
  description="Funding agencies supporting research at the Biosensors & Devices Lab, IIT Delhi."
>
  <section class="py-14 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
      <div class="mb-10 sm:mb-14">
        <div class="flex items-center gap-3 mb-3">
          <Landmark className="w-8 h-8 text-blue-700" />
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">Funding</h1>
        </div>
        <p class="mt-2 text-gray-600 text-base sm:text-lg max-w-3xl">
          Our research is supported by national and international funding agencies.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {agencies.map(a => (
          <a
            href={a.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 p-6 flex flex-col items-center text-center"
          >
            <div class="h-20 w-full flex items-center justify-center mb-4">
              <img src={a.logo} alt={`${a.name} logo`} width="160" height="80" class="max-h-20 max-w-full object-contain" />
            </div>
            <h3 class="text-sm font-semibold text-gray-900 leading-snug">{a.name}</h3>
            <p class="mt-2 text-xs text-gray-500 leading-relaxed flex-grow">{a.desc}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-blue-700 group-hover:underline">
              Visit website <ExternalLink className="w-3 h-3" />
            </span>
          </a>
        ))}
      </div>

      <div class="mt-12 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <div class="flex items-center gap-2 mb-2">
          <Award className="w-5 h-5 text-blue-700" />
          <h2 class="font-semibold text-gray-900">Grant Acknowledgements</h2>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed">
          Specific grant numbers and project titles will be listed here as provided by the
          lab. Please contact <a href="mailto:nks@iitd.ac.in" class="text-blue-700 underline">nks@iitd.ac.in</a>
          for the current list of active grants.
        </p>
      </div>
    </div>
  </section>
</Layout>
