---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { ArrowRight, Calendar } from 'lucide-react';
import { SITE } from '../config.ts';
// V2 equipment strip images
import tecanImg from '../assets/equipment/tecan-infinite-m-plex.jpg';
import zeissImg from '../assets/equipment/zeiss-stereo-microscope.jpg';
import eppendorfImg from '../assets/equipment/eppendorf-centrifuge-5430-r.jpg';
import bioradImg from '../assets/equipment/biorad-cfx-opus-96.jpg';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

const papers = (await getCollection('publications'))
  .filter(p => p.data.type === 'paper' && p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const newsItems = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const researchAreas = (await getCollection('research'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// Hero stats derived from content collections — never go stale
const paperCount = (await getCollection('publications')).filter(p => p.data.type === 'paper').length;
const patentCount = (await getCollection('patents')).length;
const instrumentCount = (await getCollection('equipment')).length;
const researcherCount = (await getCollection('team')).filter(m => m.data.role !== 'Alumni').length;
const stats = [
  { n: paperCount, suffix: '+', label: 'Publications' },
  { n: patentCount, suffix: '', label: 'Patents' },
  { n: instrumentCount, suffix: '', label: 'Instruments' },
  { n: researcherCount, suffix: '', label: 'Researchers' },
];

// V2 equipment strip content
const nightShots = [
  { img: tecanImg, name: 'Tecan Infinite M-Plex - plate reader' },
  { img: zeissImg, name: 'Zeiss Stereo Microscope' },
  { img: eppendorfImg, name: 'Eppendorf 5430 Centrifuge' },
  { img: bioradImg, name: 'Bio-Rad CFX Opus 96 - qPCR' },
];

// Funding logos strip (reuses the same public assets as the Funding page)
const fundingLogos = [
  { name: 'ICMR', src: basePath + '/funding-logos/icmr-logo.svg', url: 'https://www.icmr.gov.in/' },
  { name: 'DBT', src: basePath + '/funding-logos/dbt-logo.png', url: 'https://dbtindia.gov.in/' },
  { name: 'ANRF', src: basePath + '/funding-logos/anrf-logo.png', url: 'https://anrfonline.in/' },
  { name: 'ICMR-DHR', src: basePath + '/funding-logos/dhr-logo.jpg', url: 'https://dhr.gov.in/' },
  { name: 'British Council', src: basePath + '/funding-logos/bc-logo.svg', url: 'https://www.britishcouncil.org/' },
  { name: 'IIT Delhi', src: basePath + '/funding-logos/iitd-official-logo.png', url: 'https://home.iitd.ac.in/' },
];
---

<Layout title="Home">
  <!-- Hero: one focused stack, correct eye-path (title → lede → CTAs → stats) -->
  <section class="relative overflow-hidden bg-hero-gradient">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-14 sm:pb-20">
      <div class="max-w-3xl">
        <h1 class="display-1 hero-enter">
          {SITE.hero.title}
        </h1>
        <p class="hero-enter hero-enter-d1 mt-6 text-lg sm:text-xl text-gray-600 leading-relaxed max-w-2xl">
          {SITE.hero.subtitle}
        </p>
        <div class="hero-enter hero-enter-d2 mt-8 flex flex-wrap gap-4">
          <a href={basePath + "/publications"} class="btn-press inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-blue-700 text-white font-semibold hover:bg-blue-800 transition-colors">
            View Publications
            <ArrowRight className="w-4 h-4" />
          </a>
          <a href={basePath + "/team"} class="btn-press inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-gray-300 text-gray-800 font-semibold hover:border-gray-400 hover:bg-white transition-colors">
            Meet the Team
          </a>
        </div>
        <!-- Stat band: quiet numbers, hairline dividers, sits after CTAs -->
        <div class="hero-enter hero-enter-d3 mt-14 sm:mt-16 grid grid-cols-2 sm:grid-cols-4 max-w-2xl">
          {stats.map((s, i) => (
            <div class:list={["px-2 sm:px-6 first:pl-0", i > 1 ? "pt-5 sm:pt-0 border-t-0 border-gray-200" : "", i > 0 ? "sm:border-l sm:border-gray-200" : ""]}>
              <p class="stat-num text-4xl sm:text-[2.75rem] text-blue-700">
                <span data-count={s.n} data-suffix={s.suffix}>{s.n}</span>{s.suffix}
              </p>
              <p class="mt-1 text-sm text-gray-500 font-medium">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Research Areas teaser -->
  {researchAreas.length > 0 && (
    <section class="section bg-white" data-reveal>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-10">
          <h2 class="section-title">Research Areas</h2>
          <a href={basePath + "/research"} class="text-blue-700 hover:text-blue-800 font-medium text-sm flex items-center gap-1 group">
            <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
          </a>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {researchAreas.map(area => (
            <a
              href={`${basePath}/research/${area.id.replace(/\.[^/.]+$/, "")}`}
              class="group card card-hover overflow-hidden"
            >
              {area.data.cover && (
                <div class="media-zoom h-36 overflow-hidden bg-gray-100">
                  <img src={area.data.cover.src} alt="" class="w-full h-full object-cover" loading="lazy" />
                </div>
              )}
              <div class="p-6">
                <h3 class="font-semibold text-gray-900 mb-2 group-hover:text-blue-700 transition-colors line-clamp-1">
                  {area.data.title}
                </h3>
                <p class="text-gray-600 text-sm leading-relaxed line-clamp-3">
                  {area.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Selected Publications -->
  <section class="section bg-gray-50" data-reveal>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-10">
          <h2 class="section-title">Selected Publications</h2>
          <a href={basePath + "/publications"} class="text-blue-700 hover:text-blue-800 font-medium text-sm flex items-center gap-1 group">
            <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
          </a>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
        {papers.map(paper => {
          const link = paper.data.links?.doi || paper.data.links?.website || paper.data.links?.pdf || '/publications';
          const isExternal = link.startsWith('http');
          return (
          <a 
            href={isExternal ? link : basePath + link}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined} 
            class="card card-hover overflow-hidden flex flex-col h-full group"
          >
             <div class="p-6 flex flex-col flex-grow">
               <h3 class="text-lg font-semibold text-gray-900 mb-2 line-clamp-2 group-hover:text-blue-600 transition-colors">
                 {paper.data.title}
               </h3>
               <p class="text-gray-600 mb-4 text-sm line-clamp-2 flex-grow" title={paper.data.authors.join(', ')}>
                 {paper.data.authors.length > 3 
                   ? `${paper.data.authors.slice(0, 3).join(', ')}, et al.` 
                   : paper.data.authors.join(', ')}
               </p>
               <div class="flex items-center justify-between text-sm mt-auto gap-4 pt-2">
                  <span class="font-medium text-blue-800 bg-blue-50 px-2.5 py-1 rounded-md truncate text-left block max-w-full" title={paper.data.venue}>{paper.data.venue}</span>
                  <span class="text-gray-500 shrink-0 tabular-nums">{paper.data.year}</span>
               </div>
             </div>
          </a>
        )})}
      </div>
    </div>
  </section>

  <!-- Latest News -->
  <section class="section bg-white" data-reveal>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-10">
          <h2 class="section-title">Latest News</h2>
          <a href={basePath + "/news"} class="text-blue-700 hover:text-blue-800 font-medium text-sm flex items-center gap-1 group">
            <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
          </a>
        </div>

        <div class="grid gap-8 md:grid-cols-3">
        {newsItems.map(item => {
          const link = `${basePath}/news/${item.id.replace(/\.[^/.]+$/, "")}`;
          return (
          <a href={link} class="card card-hover group p-6 flex flex-col">
            <div class="text-sm text-gray-500 mb-2 flex items-center gap-2">
               <Calendar className="w-4 h-4" />
               {item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
            </div>
            <h3 class="text-lg font-semibold text-gray-900 group-hover:text-blue-700 transition-colors mb-2 line-clamp-2">
              {item.data.title}
            </h3>
            {item.data.summary && <p class="text-gray-600 line-clamp-3 text-sm">{item.data.summary}</p>}
          </a>
        )})}
      </div>
    </div>
  </section>

  <!-- V2: dark equipment strip -->
  <section class="section bg-strip-dark" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-10">
        <h2 class="section-title text-white">Instruments that power our research</h2>
        <a href={basePath + "/equipment"} class="hidden sm:inline-flex text-blue-300 hover:text-blue-200 font-medium text-sm items-center gap-1 group">
          <span>All {instrumentCount} instruments</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
        </a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
        {nightShots.map((shot, i) => (
          <a
            href={basePath + '/equipment'}
            class:list={[
              'group relative rounded-xl overflow-hidden ring-1 ring-white/10 hover:ring-blue-300/40 transition-all',
              i === 0 ? 'lg:col-span-2 lg:row-span-1' : ''
            ]}
          >
            <Image
              src={shot.img}
              alt={shot.name}
              widths={[480, 720]}
              sizes="(max-width: 640px) 50vw, 25vw"
              loading="lazy"
              class="night-photo w-full h-full min-h-[180px] lg:min-h-[220px] object-cover opacity-85 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-500"
            />
            <span class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-gray-950/90 to-transparent p-4 pt-10 text-sm font-medium text-gray-100">
              {shot.name}
            </span>
          </a>
        ))}
      </div>
      <a href={basePath + "/equipment"} class="sm:hidden inline-flex mt-6 text-blue-300 font-medium">All {instrumentCount} instruments &rarr;</a>
    </div>
  </section>

  <!-- Funding / affiliations strip -->
  <section class="py-14 bg-gray-50 border-t border-gray-100" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm text-gray-500 font-medium text-center mb-8">Research supported by</p>
      <div class="flex flex-wrap justify-center items-center gap-x-10 gap-y-6">
        {fundingLogos.map(logo => (
          <a
            href={logo.url}
            target="_blank"
            rel="noopener noreferrer"
            title={logo.name}
            class="opacity-75 hover:opacity-100 transition-opacity"
          >
            <img src={logo.src} alt={`${logo.name} logo`} width="120" height="50" class="h-12 w-auto object-contain" loading="lazy" />
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href={basePath + "/funding"} class="text-sm text-blue-700 hover:text-blue-800 font-medium">
          Learn more about our funding &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  // Count-up animation for hero stats. HTML ships the real numbers (no-JS safe);
  // JS resets to 0 and animates only when motion is allowed.
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var els = document.querySelectorAll('[data-count]');
    if (!els.length) return;
    var DURATION = 1200;
    els.forEach(function (el) {
      var target = parseInt(el.getAttribute('data-count'), 10) || 0;
      var start = null;
      el.textContent = '0';
      function step(ts) {
        if (start === null) start = ts;
        var p = Math.min((ts - start) / DURATION, 1);
        var eased = 1 - Math.pow(1 - p, 3); // ease-out cubic
        el.textContent = Math.round(target * eased).toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });
  })();
</script>