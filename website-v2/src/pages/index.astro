---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { ArrowRight, Calendar, Landmark } from 'lucide-react';
import { SITE } from '../config.ts';
// V2 equipment strip images
import tecanImg from '../assets/equipment/tecan-infinite-m-plex.jpg';
import zeissImg from '../assets/equipment/zeiss-stereo-microscope.jpg';
import eppendorfImg from '../assets/equipment/eppendorf-centrifuge-5430-r.jpg';
import bioradImg from '../assets/equipment/biorad-cfx-opus-96.jpg';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

const papers = (await getCollection('publications'))
  .filter(p => p.data.type === 'paper' && p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const newsItems = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const researchAreas = (await getCollection('research'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// Hero stats derived from content collections — never go stale
const paperCount = (await getCollection('publications')).filter(p => p.data.type === 'paper').length;
const patentCount = (await getCollection('patents')).length;
const instrumentCount = (await getCollection('equipment')).length;
const researcherCount = (await getCollection('team')).filter(m => m.data.role !== 'Alumni').length;
const stats = [
  { n: paperCount, suffix: '+', label: 'Publications' },
  { n: patentCount, suffix: '', label: 'Patents' },
  { n: instrumentCount, suffix: '', label: 'Instruments' },
  { n: researcherCount, suffix: '', label: 'Researchers' },
];

// V2 equipment strip content
const nightShots = [
  { img: tecanImg, name: 'Tecan Infinite M-Plex - plate reader' },
  { img: zeissImg, name: 'Zeiss Stereo Microscope' },
  { img: eppendorfImg, name: 'Eppendorf 5430 Centrifuge' },
  { img: bioradImg, name: 'Bio-Rad CFX Opus 96 - qPCR' },
];

// Funding logos strip (reuses the same public assets as the Funding page)
const fundingLogos = [
  { name: 'ICMR', src: basePath + '/funding-logos/icmr-logo.svg', url: 'https://www.icmr.gov.in/' },
  { name: 'DBT', src: basePath + '/funding-logos/dbt-logo.png', url: 'https://dbtindia.gov.in/' },
  { name: 'ANRF', src: basePath + '/funding-logos/anrf-logo.png', url: 'https://anrfonline.in/' },
  { name: 'ICMR-DHR', src: basePath + '/funding-logos/dhr-logo.jpg', url: 'https://dhr.gov.in/' },
  { name: 'British Council', src: basePath + '/funding-logos/bc-logo.svg', url: 'https://www.britishcouncil.org/' },
  { name: 'IIT Delhi', src: basePath + '/funding-logos/iitd-official-logo.png', url: 'https://home.iitd.ac.in/' },
];
---

<Layout title="Home">
  <!-- Hero Section v2.2 Premium -->
  <section class="relative overflow-hidden bg-hero-gradient min-h-[90vh] flex items-center">
    <!-- Animated gradient mesh -->
    <div class="hero-mesh"></div>
    <!-- Floating particles -->
    <div class="hero-particles">
      <div class="hero-particle"></div>
      <div class="hero-particle"></div>
      <div class="hero-particle"></div>
      <div class="hero-particle"></div>
      <div class="hero-particle"></div>
      <div class="hero-particle"></div>
    </div>
    <!-- Dot pattern -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(#1d4ed8 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 lg:py-32">
      <div class="max-w-3xl mx-auto">
        <div>
          <p class="hero-enter inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-600/10 text-blue-700 text-sm font-medium mb-6 badge-float">
            {SITE.university} · Centre for Biomedical Engineering
          </p>
          <h1 class="hero-enter hero-enter-d1 text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-6"><span class="gradient-text">
            {SITE.hero.title}</span>
          </h1>
          <p class="hero-enter hero-enter-d2 text-lg sm:text-xl text-gray-600 leading-relaxed mb-8">
            {SITE.hero.subtitle}
          </p>
          <!-- V2: animated stat counters -->
          <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-8 max-w-xl">
            {stats.map(s => (
              <div class="text-center sm:text-left">
                <p class="text-3xl font-extrabold text-blue-700 tabular-nums">
                  <span data-count={s.n} data-suffix={s.suffix}>{s.n}</span>{s.suffix}
                </p>
                <p class="text-sm text-gray-500 font-medium">{s.label}</p>
              </div>
            ))}
          </div>
          <div class="hero-enter hero-enter-d3 flex flex-wrap gap-4">
            <a href={basePath + "/publications"} class="btn-premium btn-press inline-flex items-center gap-2 px-8 py-4 rounded-full bg-blue-600 text-white font-semibold">
              View Publications
              <ArrowRight className="w-4 h-4" />
            </a>
            <a href={basePath + "/team"} class="btn-press inline-flex items-center gap-2 px-8 py-4 rounded-full border-2 border-gray-200 text-gray-700 font-semibold hover:border-blue-400 hover:text-blue-600 hover:bg-blue-50/50">
              Meet the Team
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Research Areas teaser -->
  {researchAreas.length > 0 && (
    <section class="py-16 bg-white" data-reveal>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-8">
          <h2 class="text-3xl font-bold text-gray-900"><span class="animated-underline">Research Areas</span></h2>
          <a href={basePath + "/research"} class="text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1 group">
            <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {researchAreas.map(area => (
            <a
              href={`${basePath}/research/${area.id.replace(/\.[^/.]+$/, "")}`}
              class="group card-premium relative bg-white border border-gray-100 rounded-2xl overflow-hidden"
            >
              <div class="h-1.5 bg-gradient-to-r from-blue-600 to-cyan-500"></div>
              <div class="p-6">
                <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors line-clamp-1">
                  {area.data.title}
                </h3>
                <p class="text-gray-600 text-sm leading-relaxed line-clamp-3">
                  {area.data.description}
                </p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-blue-700 opacity-0 group-hover:opacity-100 transition-opacity">
                  Learn more <ArrowRight className="w-4 h-4" />
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Selected Publications -->
  <section class="py-16 bg-gray-50" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-8">
        <h2 class="text-3xl font-bold text-gray-900"><span class="animated-underline">Selected Publications</span></h2>
        <a href={basePath + "/publications"} class="text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1 group">
          <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {papers.map(paper => {
          const link = paper.data.links?.doi || paper.data.links?.website || paper.data.links?.pdf || '/publications';
          const isExternal = link.startsWith('http');
          return (
          <a 
            href={isExternal ? link : basePath + link}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined} 
            class="card-premium bg-white rounded-xl border border-gray-100 overflow-hidden flex flex-col h-full group"
          >
             <div class="p-6 flex flex-col flex-grow">
               <h3 class="text-lg font-semibold text-gray-900 mb-2 line-clamp-2 group-hover:text-blue-600 transition-colors">
                 {paper.data.title}
               </h3>
               <p class="text-gray-600 mb-4 text-sm line-clamp-2 flex-grow" title={paper.data.authors.join(', ')}>
                 {paper.data.authors.length > 3 
                   ? `${paper.data.authors.slice(0, 3).join(', ')}, et al.` 
                   : paper.data.authors.join(', ')}
               </p>
               <div class="flex items-center justify-between text-sm mt-auto gap-4">
                  <span class="font-medium text-blue-600 bg-blue-50 px-2 py-1 rounded truncate text-left block max-w-full" title={paper.data.venue}>{paper.data.venue}</span>
                  <span class="text-gray-500 shrink-0">{paper.data.year}</span>
               </div>
             </div>
          </a>
        )})}
      </div>
    </div>
  </section>

  <!-- Latest News -->
  <section class="py-16 bg-white" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-8">
        <h2 class="text-3xl font-bold text-gray-900"><span class="animated-underline">Latest News</span></h2>
        <a href={basePath + "/news"} class="text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1 group">
          <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {newsItems.map(item => {
          const link = `${basePath}/news/${item.id.replace(/\.[^/.]+$/, "")}`;
          return (
          <a href={link} class="group bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all p-6 flex flex-col">
            <div class="text-sm text-gray-500 mb-2 flex items-center gap-2">
               <Calendar className="w-4 h-4" />
               {item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
            </div>
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2 line-clamp-2">
              {item.data.title}
            </h3>
            {item.data.summary && <p class="text-gray-600 line-clamp-3 text-sm">{item.data.summary}</p>}
          </a>
        )})}
      </div>
    </div>
  </section>

  <!-- V2: dark equipment strip -->
  <section class="py-16 bg-gray-950" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-10">
        <div>
          <p class="text-sm font-medium text-cyan-400 mb-2 tracking-wide uppercase">Inside the Lab</p>
          <h2 class="text-3xl font-bold text-white"><span class="animated-underline" style="--underline-color: #06b6d4">Instruments that power our research</span></h2>
        </div>
        <a href={basePath + "/equipment"} class="hidden sm:inline-flex text-cyan-300 hover:text-cyan-200 font-medium items-center gap-1 group">
          <span>All {instrumentCount} instruments</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
        {nightShots.map((shot, i) => (
          <a
            href={basePath + '/equipment'}
            class:list={[
              'group relative rounded-2xl overflow-hidden ring-1 ring-white/10 hover:ring-cyan-400/50 transition-all',
              i === 0 ? 'lg:col-span-2 lg:row-span-1' : ''
            ]}
          >
            <Image
              src={shot.img}
              alt={shot.name}
              widths={[480, 720]}
              sizes="(max-width: 640px) 50vw, 25vw"
              loading="lazy"
              class="night-photo w-full h-full min-h-[180px] lg:min-h-[220px] object-cover opacity-80 group-hover:opacity-100 group-hover:scale-[1.03] transition-all duration-500"
            />
            <span class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-gray-950/90 to-transparent p-4 pt-10 text-sm font-medium text-gray-100">
              {shot.name}
            </span>
          </a>
        ))}
      </div>
      <a href={basePath + "/equipment"} class="sm:hidden inline-flex mt-6 text-cyan-300 font-medium">All {instrumentCount} instruments &rarr;</a>
    </div>
  </section>

  <!-- Funding / affiliations strip -->
  <section class="py-14 bg-gray-50 border-t border-gray-100" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-2 mb-8">
        <Landmark className="w-5 h-5 text-gray-500" />
        <p class="text-sm text-gray-500 font-medium uppercase tracking-wider">Research supported by</p>
      </div>
      <div class="flex flex-wrap justify-center items-center gap-x-10 gap-y-6 opacity-75 hover:opacity-100 transition-opacity">
        {fundingLogos.map(logo => (
          <a
            href={logo.url}
            target="_blank"
            rel="noopener noreferrer"
            title={logo.name}
            class="grayscale hover:grayscale-0 transition-all"
          >
            <img src={logo.src} alt={`${logo.name} logo`} class="h-12 w-auto object-contain" loading="lazy" />
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href={basePath + "/funding"} class="text-sm text-blue-600 hover:text-blue-700 font-medium">
          Learn more about our funding →
        </a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  // Count-up animation for hero stats. HTML ships the real numbers (no-JS safe);
  // JS resets to 0 and animates only when motion is allowed.
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var els = document.querySelectorAll('[data-count]');
    if (!els.length) return;
    var DURATION = 1200;
    els.forEach(function (el) {
      var target = parseInt(el.getAttribute('data-count'), 10) || 0;
      var start = null;
      el.textContent = '0';
      function step(ts) {
        if (start === null) start = ts;
        var p = Math.min((ts - start) / DURATION, 1);
        var eased = 1 - Math.pow(1 - p, 3); // ease-out cubic
        el.textContent = Math.round(target * eased).toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });
  })();
</script>