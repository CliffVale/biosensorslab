---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { ArrowRight, Calendar } from 'lucide-react';
import { SITE } from '../config.ts';
// V2 equipment strip images
import tecanImg from '../assets/equipment/tecan-infinite-m-plex.jpg';
import zeissImg from '../assets/equipment/zeiss-stereo-microscope.jpg';
import eppendorfImg from '../assets/equipment/eppendorf-centrifuge-5430-r.jpg';
import bioradImg from '../assets/equipment/biorad-cfx-opus-96.jpg';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

const papers = (await getCollection('publications'))
  .filter(p => p.data.type === 'paper' && p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const newsItems = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const researchAreas = (await getCollection('research'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// Hero stats derived from content collections — never go stale
const paperCount = (await getCollection('publications')).filter(p => p.data.type === 'paper').length;
const patentCount = (await getCollection('patents')).length;
const instrumentCount = (await getCollection('equipment')).length;
const researcherCount = (await getCollection('team')).filter(m => m.data.role !== 'Alumni').length;
const teamPreview = (await getCollection('team'))
  .filter(m => m.data.role !== 'Alumni' && m.data.role !== 'Principal Investigator')
  .sort((a, b) => (a.data.weight ?? 99) - (b.data.weight ?? 99))
  .slice(0, 4);
const stats = [
  { n: paperCount, suffix: '+', label: 'Publications' },
  { n: patentCount, suffix: '', label: 'Patents' },
  { n: instrumentCount, suffix: '', label: 'Instruments' },
  { n: researcherCount, suffix: '', label: 'Researchers' },
];

// V2 equipment strip content
const nightShots = [
  { img: tecanImg, name: 'Tecan Infinite M-Plex - plate reader' },
  { img: zeissImg, name: 'Zeiss Stereo Microscope' },
  { img: eppendorfImg, name: 'Eppendorf 5430 Centrifuge' },
  { img: bioradImg, name: 'Bio-Rad CFX Opus 96 - qPCR' },
];

// Funding logos strip (reuses the same public assets as the Funding page)
const fundingLogos = [
  { name: 'ICMR', src: basePath + '/funding-logos/icmr-logo.svg', url: 'https://www.icmr.gov.in/' },
  { name: 'DBT', src: basePath + '/funding-logos/dbt-logo.png', url: 'https://dbtindia.gov.in/' },
  { name: 'ANRF', src: basePath + '/funding-logos/anrf-logo.png', url: 'https://anrfonline.in/' },
  { name: 'ICMR-DHR', src: basePath + '/funding-logos/dhr-logo.jpg', url: 'https://dhr.gov.in/' },
  { name: 'British Council', src: basePath + '/funding-logos/bc-logo.svg', url: 'https://www.britishcouncil.org/' },
  { name: 'IIT Delhi', src: basePath + '/funding-logos/iitd-official-logo.png', url: 'https://home.iitd.ac.in/' },
];
---

<Layout title="Home">
  <!-- Hero: one focused stack, correct eye-path (title → lede → CTAs → stats) -->
  <section class="relative overflow-hidden bg-hero-gradient">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-14 sm:pb-20">
      <div class="max-w-3xl">
        <h1 class="display-1 hero-enter">
          {SITE.hero.title}
        </h1>
        <p class="hero-enter hero-enter-d1 mt-6 text-lg sm:text-xl text-gray-600 leading-relaxed max-w-2xl">
          {SITE.hero.subtitle}
        </p>
        <div class="hero-enter hero-enter-d2 mt-8 flex flex-wrap gap-4">
          <a href={basePath + "/publications"} class="btn-press inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-emerald-700 text-white font-semibold hover:bg-emerald-800 transition-colors">
            View Publications
            <ArrowRight className="w-4 h-4" />
          </a>
          <a href={basePath + "/team"} class="btn-press inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-gray-300 text-gray-800 font-semibold hover:border-gray-400 hover:bg-white transition-colors">
            Meet the Team
          </a>
        </div>
        <!-- Stat band: quiet numbers, hairline dividers, sits after CTAs -->
        <div class="hero-enter hero-enter-d3 mt-14 sm:mt-16 grid grid-cols-2 sm:grid-cols-4 max-w-2xl">
          {stats.map((s, i) => (
            <div class:list={["px-2 sm:px-6 first:pl-0", i > 1 ? "pt-5 sm:pt-0 border-t-0 border-gray-200" : "", i > 0 ? "sm:border-l sm:border-gray-200" : ""]}>
              <p class="stat-num text-4xl sm:text-[2.75rem] text-emerald-700">
                <span data-count={s.n} data-suffix={s.suffix}>{s.n}</span>{s.suffix}
              </p>
              <p class="mt-1 text-sm text-gray-500 font-medium">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Research Areas teaser -->
  {researchAreas.length > 0 && (
    <section id="research" class="section bg-white scroll-target" data-reveal>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-10">
          <div>
            <p class="section-eyebrow eyebrow-teal">What we do</p>
            <h2 class="section-title">Research Areas</h2>
          </div>
          <a href={basePath + "/research"} class="text-emerald-700 hover:text-emerald-800 font-medium text-sm flex items-center gap-1 group">
            <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
          </a>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {researchAreas.map(area => (
            <a
              href={`${basePath}/research/${area.id.replace(/\.[^/.]+$/, "")}`}
              class="group card card-hover overflow-hidden"
            >
              {area.data.cover && (
                <div class="media-zoom h-36 overflow-hidden bg-gray-100">
                  <img src={area.data.cover.src} alt="" class="w-full h-full object-cover" loading="lazy" />
                </div>
              )}
              <div class="p-6">
                <h3 class="font-semibold text-gray-900 mb-2 group-hover:text-emerald-700 transition-colors line-clamp-1">
                  {area.data.title}
                </h3>
                <p class="text-gray-600 text-sm leading-relaxed line-clamp-3">
                  {area.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Selected Publications -->
  <section id="publications" class="section bg-gray-50 scroll-target" data-reveal>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-10">
          <div>
            <p class="section-eyebrow eyebrow-blue">Our work</p>
            <h2 class="section-title">Selected Publications</h2>
          </div>
          <a href={basePath + "/publications"} class="text-emerald-700 hover:text-emerald-800 font-medium text-sm flex items-center gap-1 group">
            <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
          </a>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
        {papers.map(paper => {
          const link = paper.data.links?.doi || paper.data.links?.website || paper.data.links?.pdf || '/publications';
          const isExternal = link.startsWith('http');
          return (
          <a 
            href={isExternal ? link : basePath + link}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined} 
            class="card card-hover overflow-hidden flex flex-col h-full group"
          >
             <div class="p-6 flex flex-col flex-grow">
               <h3 class="text-lg font-semibold text-gray-900 mb-2 line-clamp-2 group-hover:text-emerald-600 transition-colors">
                 {paper.data.title}
               </h3>
               <p class="text-gray-600 mb-4 text-sm line-clamp-2 flex-grow" title={paper.data.authors.join(', ')}>
                 {paper.data.authors.length > 3 
                   ? `${paper.data.authors.slice(0, 3).join(', ')}, et al.` 
                   : paper.data.authors.join(', ')}
               </p>
               <div class="flex items-center justify-between text-sm mt-auto gap-4 pt-2">
                  <span class="font-medium text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-md truncate text-left block max-w-full" title={paper.data.venue}>{paper.data.venue}</span>
                  <span class="text-gray-500 shrink-0 tabular-nums">{paper.data.year}</span>
               </div>
             </div>
          </a>
        )})}
      </div>
    </div>
  </section>

  <!-- Team screen -->
  <section id="team" class="section bg-white scroll-target" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-10">
        <div>
          <p class="section-eyebrow eyebrow-blue">The people</p>
          <h2 class="section-title">Meet the team</h2>
        </div>
        <a href={basePath + "/team"} class="text-emerald-700 hover:text-emerald-800 font-medium text-sm flex items-center gap-1 group">
          <span>All {researcherCount} researchers</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
        </a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
        {teamPreview.map(m => (
          <a
            href={`${basePath}/team/${m.id.replace(/\.[^/.]+$/, "")}`}
            class="group card card-hover overflow-hidden"
          >
            <div class="media-zoom aspect-[4/5] overflow-hidden bg-gray-100">
              {m.data.avatar ? (
                <Image
                  src={m.data.avatar}
                  alt={m.data.name}
                  class="w-full h-full object-cover"
                  widths={[320, 480]}
                  sizes="(max-width: 640px) 50vw, 25vw"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-gray-100">
                  <span class="text-3xl font-bold text-gray-300">{m.data.name.split(/\s+/).slice(0, 2).map(w => w[0].toUpperCase()).join('')}</span>
                </div>
              )}
            </div>
            <div class="p-4">
              <p class="font-semibold text-gray-900 text-sm group-hover:text-emerald-700 transition-colors">{m.data.name}</p>
              <p class="text-xs text-gray-500 mt-0.5">{m.data.role}</p>
            </div>
          </a>
        ))}
      </div>
      <a href={basePath + "/team"} class="sm:hidden inline-flex mt-6 text-emerald-700 font-medium">All {researcherCount} researchers &rarr;</a>
    </div>
  </section>

  <!-- Latest News -->
  <section id="news" class="section bg-white scroll-target" data-reveal>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-10">
          <div>
            <p class="section-eyebrow eyebrow-teal">Recent</p>
            <h2 class="section-title">Latest News</h2>
          </div>
          <a href={basePath + "/news"} class="text-emerald-700 hover:text-emerald-800 font-medium text-sm flex items-center gap-1 group">
            <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
          </a>
        </div>

        <div class="grid gap-8 md:grid-cols-3">
        {newsItems.map(item => {
          const link = `${basePath}/news/${item.id.replace(/\.[^/.]+$/, "")}`;
          return (
          <a href={link} class="card card-hover group p-6 flex flex-col">
            <div class="text-sm text-gray-500 mb-2 flex items-center gap-2">
               <Calendar className="w-4 h-4" />
               {item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
            </div>
            <h3 class="text-lg font-semibold text-gray-900 group-hover:text-emerald-700 transition-colors mb-2 line-clamp-2">
              {item.data.title}
            </h3>
            {item.data.summary && <p class="text-gray-600 line-clamp-3 text-sm">{item.data.summary}</p>}
          </a>
        )})}
      </div>
    </div>
  </section>

  <!-- V2: dark equipment strip -->
  <section id="equipment" class="section bg-strip-dark scroll-target" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-10">
        <div>
          <p class="section-eyebrow eyebrow-blue" style="color:#6ee7b7;">Inside the lab</p>
          <h2 class="section-title text-white">Instruments that power our research</h2>
        </div>
        <a href={basePath + "/equipment"} class="hidden sm:inline-flex text-emerald-300 hover:text-emerald-200 font-medium text-sm items-center gap-1 group">
          <span>All {instrumentCount} instruments</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
        </a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
        {nightShots.map((shot, i) => (
          <a
            href={basePath + '/equipment'}
            class:list={[
              'group relative rounded-xl overflow-hidden ring-1 ring-white/10 hover:ring-emerald-300/40 transition-all',
              i === 0 ? 'lg:col-span-2 lg:row-span-1' : ''
            ]}
          >
            <Image
              src={shot.img}
              alt={shot.name}
              widths={[480, 720]}
              sizes="(max-width: 640px) 50vw, 25vw"
              loading="lazy"
              class="night-photo w-full h-full min-h-[180px] lg:min-h-[220px] object-cover opacity-85 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-500"
            />
            <span class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-gray-950/90 to-transparent p-4 pt-10 text-sm font-medium text-gray-100">
              {shot.name}
            </span>
          </a>
        ))}
      </div>
      <a href={basePath + "/equipment"} class="sm:hidden inline-flex mt-6 text-emerald-300 font-medium">All {instrumentCount} instruments &rarr;</a>
    </div>
  </section>

  <!-- Funding / affiliations strip -->
  <section id="funding" class="py-14 bg-gray-50 border-t border-gray-100 scroll-target" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm text-gray-500 font-medium text-center mb-8"><span class="text-institute">■</span> Research supported by</p>
      <div class="flex flex-wrap justify-center items-center gap-x-10 gap-y-6">
        {fundingLogos.map(logo => (
          <a
            href={logo.url}
            target="_blank"
            rel="noopener noreferrer"
            title={logo.name}
            class="opacity-75 hover:opacity-100 transition-opacity"
          >
            <img src={logo.src} alt={`${logo.name} logo`} width="120" height="50" class="h-12 w-auto object-contain" loading="lazy" />
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href={basePath + "/funding"} class="text-sm text-emerald-700 hover:text-emerald-800 font-medium">
          Learn more about our funding &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Join CTA band: closes the scroll narrative -->
  <section id="join" class="section scroll-target" style="background: linear-gradient(180deg, #f8fafc 0%, #ecfdf5 100%);" data-reveal>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-eyebrow eyebrow-blue justify-center">Open positions</p>
      <h2 class="section-title">Join the lab</h2>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto">
        We are always looking for motivated students and researchers with backgrounds in
        chemistry, biology, electronics, or bioengineering.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={basePath + "/contact#join"} class="btn-press inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-emerald-700 text-white font-semibold hover:bg-emerald-800 transition-colors">
          Apply to Join Us <ArrowRight className="w-4 h-4" />
        </a>
        <a href={basePath + "/contact"} class="btn-press inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-gray-300 text-gray-800 font-semibold hover:border-gray-400 hover:bg-white transition-colors">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>

<!-- Long-scroll wayfinding: dot nav, progress bar, back-to-top -->
<div class="scroll-progress" aria-hidden="true"></div>
<nav class="scroll-dots" aria-label="Section navigation">
  <a href="#top" class="scroll-dot" aria-label="Home"></a>
  <a href="#research" class="scroll-dot" aria-label="Research areas"></a>
  <a href="#publications" class="scroll-dot" aria-label="Selected publications"></a>
  <a href="#team" class="scroll-dot" aria-label="Team"></a>
  <a href="#news" class="scroll-dot" aria-label="Latest news"></a>
  <a href="#equipment" class="scroll-dot dot-dark" aria-label="Instruments"></a>
  <a href="#funding" class="scroll-dot" aria-label="Funding"></a>
  <a href="#join" class="scroll-dot" aria-label="Join us"></a>
</nav>
<a href="#" class="to-top" id="to-top" aria-label="Back to top">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
</a>

<script is:inline>
  // Count-up animation for hero stats. HTML ships the real numbers (no-JS safe);
  // JS resets to 0 and animates only when motion is allowed.
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var els = document.querySelectorAll('[data-count]');
    if (!els.length) return;
    var DURATION = 1200;
    els.forEach(function (el) {
      var target = parseInt(el.getAttribute('data-count'), 10) || 0;
      var start = null;
      el.textContent = '0';
      function step(ts) {
        if (start === null) start = ts;
        var p = Math.min((ts - start) / DURATION, 1);
        var eased = 1 - Math.pow(1 - p, 3); // ease-out cubic
        el.textContent = Math.round(target * eased).toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });
  })();

  // Scroll journey: enable snap screens only on capable devices.
  // Gates: JS on, desktop-size viewport, no reduced-motion, enough CPU cores/RAM.
  (function () {
    var ok = window.matchMedia('(min-width: 1024px) and (min-height: 700px)').matches
      && !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      && (navigator.hardwareConcurrency || 4) >= 4
      && !(navigator.deviceMemory && navigator.deviceMemory <= 2);
    if (ok) {
      document.documentElement.classList.add('scroll-journey');
      // Snap needs real section boundaries: cap each band to viewport height
      // is NOT enforced on purpose (content must never be clipped); proximity
      // snapping lets long sections scroll naturally while boundaries guide.
    }
  })();

  // Scrollspy: highlight the dot nav for the section in view + back-to-top.
  (function () {
    var dots = document.querySelectorAll('.scroll-dots a');
    var targets = document.querySelectorAll('.scroll-target');
    var toTop = document.getElementById('to-top');
    if (!targets.length || !dots.length || !('IntersectionObserver' in window)) return;
    function setActive(id) {
      dots.forEach(function (d) {
        d.classList.toggle('active', d.getAttribute('href') === '#' + id);
      });
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) setActive(en.target.id);
      });
    }, { rootMargin: '-45% 0px -45% 0px' });
    targets.forEach(function (t) { io.observe(t); });
    // Hero has no .scroll-target; treat scrollY near top as Home
    function homeCheck() {
      if (window.scrollY < window.innerHeight * 0.4) setActive('top');
    }
    window.addEventListener('scroll', homeCheck, { passive: true });
    homeCheck();
    if (toTop) {
      window.addEventListener('scroll', function () {
        toTop.classList.toggle('show', window.scrollY > 800);
      }, { passive: true });
    }
  })();
</script>
