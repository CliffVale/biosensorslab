---
import Layout from '../layouts/Layout.astro';
import TeamCard from '../components/TeamCard.astro';
import { Image } from 'astro:assets';
import { Mail, GraduationCap, Award, Microscope, Users, Camera } from 'lucide-react';
import { getCollection } from 'astro:content';
import avatar from '../assets/avatar-nks.png';
import team2026 from '../assets/gallery/gallery-team2026.jpg';

// ---- PI content (merged from the former /pi page) ----
const milestones = [
  { period: '2023 – present', text: 'Assistant Professor, Centre for Biomedical Engineering, IIT Delhi' },
  { period: '2019 – 2022', text: 'Postdoctoral Fellow, University of California San Diego (UCSD), ECE (with Prof. Drew Hall)' },
  { period: '2017', text: 'Visiting Scholar, University of Bath, UK (with Prof. Pedro Estrela)' },
  { period: '2013 – 2019', text: 'PhD, Indian Institute of Technology Guwahati' },
  { period: '2011 – 2013', text: 'M.Tech, Birla Institute of Technology and Science (BITS) Pilani' },
  { period: '2007 – 2011', text: 'B.Tech, Allahabad Agricultural University' },
];

const honors = [
  'NIH RADx Program (2020)',
  'XPRIZE PanDemiX (2020)',
  'Newton-Bhabha Fund (2017)',
  'GATE 2011 (90.8 percentile)',
];

// ---- Lab members (former team page) ----
const allMembers = (await getCollection('team'))
  .filter(m => m.data.role !== 'Principal Investigator'); // PI has their own section above

const groups = [
  { id: 'faculty', title: 'Faculty', roles: ['Professor', 'Associate Professor', 'Assistant Professor'] },
  { id: 'postdoc', title: 'Postdoctoral Researchers', roles: ['Postdoc'] },
  { id: 'scientist', title: 'Research Scientists', roles: ['Research Scientist'] },
  { id: 'staff', title: 'Research Support', roles: ['Research Assistant'] },
  { id: 'phd', title: 'PhD Students', roles: ['PhD Student'] },
  { id: 'master', title: 'Master Students', roles: ['Master Student'] },
  { id: 'undergrad', title: 'Undergraduate Students', roles: ['Undergraduate'] },
  { id: 'alumni', title: 'Alumni', roles: ['Alumni'] },
];

const getRolePriority = (role: string) => {
  const priorities: Record<string, number> = {
    'Professor': 1,
    'Associate Professor': 2,
    'Assistant Professor': 3,
    'Postdoc': 4,
    'Research Scientist': 5,
    'Research Assistant': 6,
    'PhD Student': 7,
    'Master Student': 8,
    'Undergraduate': 9,
    'Alumni': 10
  };
  return priorities[role] ?? 99;
};

const groupedMembers = groups.reduce((acc, group) => {
  const members = allMembers
    .filter(m => group.roles.includes(m.data.role))
    .sort((a, b) => {
      const roleDiff = getRolePriority(a.data.role) - getRolePriority(b.data.role);
      if (roleDiff !== 0) return roleDiff;
      return (a.data.weight || 100) - (b.data.weight || 100);
    });

  if (members.length > 0) {
    acc.push({ ...group, members });
  }
  return acc;
}, [] as Array<{ id: string, title: string, roles: string[], members: typeof allMembers }>);
---

<Layout
  title="Team"
  description="Dr. Naveen Kumar Singh and the researchers of the Biosensors & Devices Lab, IIT Delhi."
>
  <!-- ===== Principal Investigator (former /pi page) ===== -->
  <section class="py-14 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
        <!-- Photo -->
        <div class="md:col-span-1">
          <div class="md:sticky md:top-24">
            <div class="aspect-[3/4] rounded-2xl overflow-hidden border border-gray-100 shadow-lg">
              <Image src={avatar} alt="Dr. Naveen Kumar Singh" class="w-full h-full object-cover" />
            </div>
            <div class="mt-4 bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
              <h2 class="font-bold text-gray-900">Dr. Naveen Kumar Singh</h2>
              <p class="text-sm text-gray-600 mt-1">Assistant Professor</p>
              <p class="text-sm text-gray-500">Centre for Biomedical Engineering</p>
              <a href="mailto:nks@iitd.ac.in" class="mt-3 inline-flex items-center gap-2 text-sm text-blue-700 hover:underline">
                <Mail className="w-4 h-4" /> nks@iitd.ac.in
              </a>
            </div>
          </div>
        </div>

        <!-- Bio -->
        <div class="md:col-span-2">
          <div class="mb-3 flex items-center gap-3">
            <Microscope className="w-8 h-8 text-blue-700" />
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Principal Investigator</h2>
          </div>
          <p class="text-lg text-gray-700 leading-relaxed">
            Dr. Naveen Kumar Singh is an Assistant Professor at the Centre for Biomedical
            Engineering (CBME), Indian Institute of Technology Delhi, where he leads the
            Biosensors &amp; Devices Lab. His research focuses on point-of-care diagnostics,
            wearable and electrochemical biosensors, and programmable biomaterials for
            health monitoring and disease detection.
          </p>
          <p class="mt-4 text-gray-700 leading-relaxed">
            He received his PhD from IIT Guwahati (2013–2019) and held postdoctoral
            positions at the University of California San Diego (2019–2022), where he worked
            with Prof. Drew Hall on advanced biosensing platforms, and was a visiting scholar
            at the University of Bath with Prof. Pedro Estrela (2017). His contributions span
            electrochemical sensing, aptamer-based detection, and continuous health monitoring
            technologies.
          </p>

          <div class="mt-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
              <GraduationCap className="w-6 h-6 text-blue-700" /> Education &amp; Career
            </h3>
            <ol class="relative border-l-2 border-blue-100 ml-3 space-y-4">
              {milestones.map(m => (
                <li class="pl-6 relative">
                  <span class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full bg-blue-600"></span>
                  <p class="text-sm font-semibold text-blue-800">{m.period}</p>
                  <p class="text-gray-700">{m.text}</p>
                </li>
              ))}
            </ol>
          </div>

          <div class="mt-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
              <Award className="w-6 h-6 text-blue-700" /> Honors &amp; Recognition
            </h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {honors.map(h => (
                <li class="bg-white rounded-xl border border-gray-100 shadow-sm px-4 py-3 text-sm text-gray-700">{h}</li>
              ))}
            </ul>
            <p class="mt-4 text-sm text-gray-500">
              Dr. Singh holds 5+ patents and has published in leading journals including
              Nature Biotechnology, Biosensors &amp; Bioelectronics, and ACS journals.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Lab Members (former team page) ===== -->
  <section class="pb-12 sm:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
      <div class="max-w-3xl mx-auto text-center mb-12 pt-8 border-t border-gray-100">
        <div class="flex items-center justify-center gap-3 mb-4">
          <Users className="w-8 h-8 text-blue-700" />
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Our Team</h2>
        </div>
        <p class="text-lg text-gray-600">
          Meet the researchers and students behind our innovations.
        </p>
      </div>

      <!-- 2026 group photo -->
      <figure class="mb-16 rounded-3xl overflow-hidden border border-gray-100 shadow-lg max-w-4xl mx-auto">
        <div class="aspect-[4/3] sm:aspect-[16/9]">
          <Image
            src={team2026}
            alt="The Biosensors &amp; Devices Lab team, 2026"
            class="w-full h-full object-cover"
            widths={[480, 800, 1200]}
            sizes="(max-width: 896px) 100vw, 896px"
          />
        </div>
        <figcaption class="px-5 py-3.5 text-sm text-gray-600 bg-white flex items-center gap-2">
          <Camera className="w-4 h-4 text-gray-400" />
          The Biosensors &amp; Devices Lab team — 2026
        </figcaption>
      </figure>

      <div class="space-y-20">
        {groupedMembers.map(group => (
          <div>
            <h3 class="text-2xl font-bold text-gray-900 mb-8 pl-4 border-l-4 border-blue-600">
              {group.title}
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
              {group.members.map(member => (
                <TeamCard member={member} />
              ))}
            </div>
          </div>
        ))}

        {allMembers.length === 0 && (
          <p class="text-gray-500 text-center py-12">No team members found. Add markdown files to src/content/team/</p>
        )}
      </div>
    </div>
  </section>
</Layout>
