---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { FlaskConical, Microscope, Thermometer, Droplets, Zap, Printer, Dna, TestTube, Syringe, Ruler, Wind } from 'lucide-react';

const items = (await getCollection('equipment'))
  .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));

// Fallback icon + gradient per item (used until real photos are added)
const iconSet = [FlaskConical, Microscope, Thermometer, Droplets, Zap, Printer, Dna, TestTube, Syringe, Ruler, Wind];
const gradients = [
  'from-emerald-600 to-indigo-600',
  'from-emerald-500 to-cyan-600',
  'from-violet-500 to-purple-600',
  'from-rose-500 to-pink-600',
  'from-amber-500 to-orange-600',
  'from-emerald-500 to-green-600',
  'from-sky-500 to-emerald-600',
  'from-fuchsia-500 to-purple-600',
];

function fallbackIcon(i: number) {
  const Icon = iconSet[i % iconSet.length];
  return Icon;
}
function fallbackGradient(i: number) {
  return gradients[i % gradients.length];
}
---

<Layout
  title="Equipment"
  description="Instrumentation available at the BiosensorsLab, IIT Delhi."
>
  <PageHead
    eyebrow="Inside the lab"
    tone="blue"
    title="Lab Equipment"
    lede="Instrumentation for biosensor development, surface characterization, biofabrication, and molecular biology — spanning electrochemistry, SPR, spectroscopy, 3D printing, and microfluidic assembly."
    width="max-w-5xl"
  />
  <section class="pt-12 pb-4 sm:pt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" data-reveal>
        {items.map((item, i) => {
          const Icon = fallbackIcon(i);
          return (
            <div
              class="group card card-hover overflow-hidden flex flex-col"
            >
              <!-- Media area -->
              <div class={`relative aspect-[4/3] w-full bg-gradient-to-br ${fallbackGradient(i)} flex items-center justify-center overflow-hidden media-zoom`}>
                {item.data.cover ? (
                  <Image src={item.data.cover} alt={item.data.name} class="w-full h-full object-cover" widths={[320, 480, 640]} sizes="(max-width: 640px) 50vw, 25vw" loading="lazy" />
                ) : (
                  <Icon className="w-10 h-10 text-white/90" />
                )}
                {item.data.category && (
                  <span class="absolute top-2 left-2 bg-white/90 backdrop-blur text-[11px] font-medium text-gray-700 px-2 py-0.5 rounded-full">
                    {item.data.category}
                  </span>
                )}
              </div>

              <!-- Body -->
              <div class="p-3 sm:p-4 flex flex-col flex-grow">
                <h3 class="text-sm sm:text-base font-semibold text-gray-900 leading-snug">{item.data.name}</h3>
                <p class="mt-1 text-xs sm:text-sm text-gray-500 flex-grow">{item.data.function}</p>
              </div>
            </div>
          );
        })}
      </div>


    </div>
  </section>
</Layout>