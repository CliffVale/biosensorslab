---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { FileText, MapPin, CalendarDays } from 'lucide-react';

const allPatents = (await getCollection('patents'))
  .sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);

const statusStyles: Record<string, string> = {
  'Granted': 'bg-green-50 text-green-700 border-green-200',
  'Filed': 'bg-blue-50 text-blue-700 border-blue-200',
  'Application Submitted': 'bg-amber-50 text-amber-700 border-amber-200',
  'Provisional Filed': 'bg-purple-50 text-purple-700 border-purple-200',
};
---

<Layout
  title="Patents"
  description="Patent applications and intellectual property developed at the Biosensors & Devices Lab, IIT Delhi."
>
  <PageHead
    title="Patents"
    lede="Patent applications and intellectual property filed by the lab for point-of-care diagnostics, aptamer technology, and biosensing devices."
    width="max-w-4xl"
  />
  <section class="pt-12 pb-4 sm:pt-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-4">
        {allPatents.map((p, i) => (
          <div
            class="card card-hover p-5 sm:p-6 flex flex-col gap-3"
            data-reveal
            style={`transition-delay: ${Math.min(i, 5) * 40}ms`}
          >
            <div class="flex flex-wrap items-center gap-2 text-xs font-medium">
              <span class={`px-2.5 py-1 rounded-full border ${statusStyles[p.data.status] || statusStyles['Filed']}`}>
                {p.data.status}
              </span>
              <span class="px-2.5 py-1 rounded-full bg-gray-50 border border-gray-200 text-gray-600">
                {p.data.year}
              </span>
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-gray-50 border border-gray-200 text-gray-600">
                <MapPin className="w-3 h-3" /> {p.data.jurisdiction}
              </span>
            </div>

            <h3 class="text-base sm:text-lg font-semibold text-gray-900 leading-snug">
              {p.data.title}
            </h3>

            <p class="text-sm text-gray-600">
              <span class="font-medium text-gray-500">Application No.:</span> {p.data.number}
            </p>

            {p.data.date && (
              <p class="inline-flex items-center gap-1.5 text-xs text-gray-500">
                <CalendarDays className="w-3.5 h-3.5" /> Filed {p.data.date}
              </p>
            )}

            {p.data.note && (
              <p class="text-sm text-gray-500 leading-relaxed">{p.data.note}</p>
            )}
          </div>
        ))}

        {allPatents.length === 0 && (
          <p class="text-gray-500 text-center py-12">
            No patents listed yet. Add markdown files to src/content/patents/.
          </p>
        )}
      </div>

      <div class="mt-10 bg-gray-50 rounded-xl p-6 flex items-start gap-3">
        <FileText className="w-5 h-5 text-gray-500 mt-0.5 shrink-0" />
        <p class="text-sm text-gray-600">
          For licensing inquiries or collaboration on any of these technologies, please contact
          <a href="mailto:nks@iitd.ac.in" class="text-blue-700 underline mx-1">nks@iitd.ac.in</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>