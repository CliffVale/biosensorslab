---
import Layout from '../layouts/Layout.astro';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Page Not Found" description="The page you are looking for could not be found.">
  <section class="min-h-[60vh] flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-lg">
      <p class="hero-enter inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-600/10 text-emerald-700 text-sm font-medium mb-6">
        Error 404
      </p>
      <h1 class="hero-enter hero-enter-d1 text-6xl sm:text-7xl font-extrabold text-gray-900 mb-4">404</h1>
      <p class="hero-enter hero-enter-d2 text-lg text-gray-600 mb-8">
        This page could not be found. It may have been moved, or the address may be mistyped.
      </p>
      <div class="hero-enter hero-enter-d3 flex flex-wrap justify-center gap-4">
        <a
          href={basePath + '/'}
          class="btn-press inline-flex items-center gap-2 px-7 py-3 rounded-full bg-emerald-600 text-white font-medium hover:bg-emerald-700 transition-all shadow-lg shadow-emerald-600/20"
        >
          Back to Home
        </a>
        <a
          href={basePath + '/search'}
          class="btn-press inline-flex items-center gap-2 px-7 py-3 rounded-full border-2 border-gray-200 text-gray-700 font-medium hover:border-emerald-300 hover:text-emerald-600 hover:bg-white transition-all"
        >
          Search the Site
        </a>
      </div>
    </div>
  </section>
</Layout>
