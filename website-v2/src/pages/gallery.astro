---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Camera } from 'lucide-react';
import newyear from '../assets/gallery/gallery-newyear2025.jpg';
import birthday from '../assets/gallery/gallery-birthday2025.jpg';
import labview from '../assets/gallery/gallery-labview.jpg';
import team1 from '../assets/gallery/gallery-team1.jpg';
import team2 from '../assets/gallery/gallery-team2.jpg';
import team3 from '../assets/gallery/gallery-team3.jpg';
import team2026 from '../assets/gallery/gallery-team2026.jpg';

const photos = [
  { src: team2026, alt: 'The Biosensors & Devices Lab team, 2026', caption: 'The team — 2026' },
  { src: labview, alt: 'Lab view', caption: 'Inside the lab' },
  { src: newyear, alt: 'New Year celebration 2025', caption: 'New Year celebration 2025' },
  { src: birthday, alt: 'Birthday celebration 2025', caption: 'Celebrating with the team' },
  { src: team1, alt: 'Team photo', caption: 'Team' },
  { src: team2, alt: 'Team photo', caption: 'Team' },
  { src: team3, alt: 'Team photo', caption: 'Team' },
];
---

<Layout
  title="Gallery"
  description="Photos from the Biosensors & Devices Lab, IIT Delhi."
>
  <section class="py-14 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 sm:mb-14">
        <div class="flex items-center gap-3 mb-3">
          <Camera className="w-8 h-8 text-blue-700" />
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">Gallery</h1>
        </div>
        <p class="mt-2 text-gray-600 text-base sm:text-lg">Moments from the lab.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {photos.map(p => (
          <figure class="group rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-lg transition-shadow">
            <div class="aspect-[4/3] overflow-hidden">
              <Image src={p.src} alt={p.alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" widths={[480, 800, 1200]} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" />
            </div>
            {p.caption && (
              <figcaption class="px-4 py-3 text-sm text-gray-600 bg-white">{p.caption}</figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>
</Layout>
