---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { Image } from 'astro:assets';
import newyear from '../assets/gallery/gallery-newyear2025.jpg';
import birthday from '../assets/gallery/gallery-birthday2025.jpg';
import labview from '../assets/gallery/gallery-labview.jpg';
import team1 from '../assets/gallery/gallery-team1.jpg';
import team2 from '../assets/gallery/gallery-team2.jpg';
import team3 from '../assets/gallery/gallery-team3.jpg';
import team2026 from '../assets/gallery/gallery-team2026.jpg';

const photos = [
  { src: team2026, alt: 'The BiosensorsLab team, 2026', caption: 'The team — 2026' },
  { src: labview, alt: 'Lab view', caption: 'Inside the lab' },
  { src: newyear, alt: 'New Year celebration 2025', caption: 'New Year celebration 2025' },
  { src: birthday, alt: 'Birthday celebration 2025', caption: 'Celebrating with the team' },
  { src: team1, alt: 'Team photo', caption: 'Team' },
  { src: team2, alt: 'Team photo', caption: 'Team' },
  { src: team3, alt: 'Team photo', caption: 'Team' },
];
---

<Layout
  title="Gallery"
  description="Photos from the BiosensorsLab, IIT Delhi."
>
  <PageHead
    eyebrow="Lab life"
    tone="teal" title="Gallery" lede="Moments from the lab." width="max-w-5xl" />
  <section class="pt-12 pb-4 sm:pt-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6" data-reveal>
        {photos.map(p => (
          <figure class="group card card-hover overflow-hidden">
            <div class="media-zoom aspect-[4/3] overflow-hidden bg-gray-100">
              <Image src={p.src} alt={p.alt} class="w-full h-full object-cover" widths={[480, 800, 1200]} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" loading="lazy" />
            </div>
            {p.caption && (
              <figcaption class="px-4 py-3 text-sm text-gray-600 border-t border-gray-100">{p.caption}</figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>
</Layout>
