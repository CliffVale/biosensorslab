---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { ArrowRight } from 'lucide-react';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

const researchAreas = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Research">
  <PageHead
    title="Research Areas"
    lede="Point-of-care diagnostics, wearable biosensors, and programmable biomaterials — engineering devices that move from the bench to the clinic."
    width="max-w-7xl"
  />
  <div class="max-w-7xl mx-auto px-4 pt-12 pb-4" data-reveal>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {researchAreas.map(area => (
        <a
          href={`${basePath}/research/${area.id.replace(/\.[^/.]+$/, "")}`}
          class="group card card-hover overflow-hidden flex flex-col"
        >
          {area.data.cover && (
            <div class="media-zoom h-44 overflow-hidden bg-gray-100">
              <img
                src={area.data.cover.src}
                alt=""
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          )}

          <div class="p-6 flex flex-col flex-grow">
            <h2 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-blue-700 transition-colors">
              {area.data.title}
            </h2>
            <p class="text-gray-600 text-sm mb-4 line-clamp-3">
              {area.data.description}
            </p>
            <span class="mt-auto inline-flex items-center text-sm font-medium text-blue-700">
              Learn more <ArrowRight className="ml-1 w-4 h-4" />
            </span>
          </div>
        </a>
      ))}
    </div>

    {researchAreas.length === 0 && (
      <div class="text-center py-20">
        <p class="text-gray-500" data-i18n-key="research.noAreas">No research areas defined. Add markdown files to src/content/research/</p>
      </div>
    )}
  </div>
</Layout>