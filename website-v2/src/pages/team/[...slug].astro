---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Mail, Globe, Twitter, GraduationCap, ArrowLeft, Linkedin, Github } from 'lucide-react';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

export async function getStaticPaths() {
  const teamMembers = await getCollection('team');
  return teamMembers.map(member => ({
    params: { slug: member.id.replace(/\.[^/.]+$/, "") },
    props: { member },
  }));
}

const { member } = Astro.props;
const { Content } = await render(member);
const { name, role, title, avatar, email, website, linkedin, github, twitter, googleScholar } = member.data;

const initials = name.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0].toUpperCase()).join('');

---

<Layout title={name}>
  <div class="max-w-5xl mx-auto px-4 py-12 sm:py-20">
    <a href={basePath + "/team"} class="inline-flex items-center text-sm text-gray-500 hover:text-emerald-600 mb-8 transition-colors">
      <ArrowLeft className="w-4 h-4 mr-1" /> Back to Team
    </a>

    <header class="mb-8">
      <h1 class="page-title">{name}</h1>
      <p class="mt-2 text-lg text-emerald-800 font-medium">{role}</p>
    </header>

    <div class="card p-8 mb-12">
      <div class="flex flex-col md:flex-row gap-8 items-start">
        <div class="w-32 h-32 md:w-48 md:h-48 rounded-xl overflow-hidden bg-gray-100 shrink-0 mx-auto md:mx-0">
          {avatar ? (
            <img src={avatar.src} alt={name} class="w-full h-full object-cover" />
          ) : (
            <div class="w-full h-full flex items-center justify-center bg-gray-100">
              <span class="text-5xl font-bold text-gray-300">{initials}</span>
            </div>
          )}
        </div>
        
        <div class="flex-grow text-center md:text-left">
          <div class="flex flex-wrap justify-center md:justify-start gap-3">
            {email && (
              <a href={`mailto:${email}`} class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-emerald-50 hover:text-emerald-600 transition-colors text-sm">
                <Mail className="w-4 h-4" />
                <span>Email</span>
              </a>
            )}
            {website && (
              <a href={website} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-emerald-50 hover:text-emerald-600 transition-colors text-sm">
                <Globe className="w-4 h-4" />
                <span>Website</span>
              </a>
            )}
            {linkedin && (
              <a href={linkedin} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-emerald-50 hover:text-emerald-600 transition-colors text-sm">
                <Linkedin className="w-4 h-4" />
                <span>LinkedIn</span>
              </a>
            )}
            {github && (
              <a href={github} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-emerald-50 hover:text-emerald-600 transition-colors text-sm">
                <Github className="w-4 h-4" />
                <span>GitHub</span>
              </a>
            )}
            {twitter && (
              <a href={twitter} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-emerald-50 hover:text-emerald-600 transition-colors text-sm">
                <Twitter className="w-4 h-4" />
                <span>Twitter</span>
              </a>
            )}
            {googleScholar && (
              <a href={googleScholar} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-emerald-50 hover:text-emerald-600 transition-colors text-sm">
                <GraduationCap className="w-4 h-4" />
                <span>Scholar</span>
              </a>
            )}
          </div>

          {title && title.length > 0 && (
            <div class="flex flex-wrap justify-center md:justify-start gap-2 mt-4">
              {title.map((t) => (
                <span class="bg-emerald-100 text-emerald-800 text-xs px-2.5 py-0.5 rounded border border-emerald-200">
                  {t}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>

    <div class="md-content max-w-none">
      <Content />
    </div>
  </div>
</Layout>
