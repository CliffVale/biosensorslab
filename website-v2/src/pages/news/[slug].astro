---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

export async function getStaticPaths() {
  const allNews = await getCollection('news');
  return allNews.map(item => ({
    params: { slug: item.id.replace(/\.[^/.]+$/, "") },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<Layout title={item.data.title} description={item.data.summary}>
  <article class="max-w-4xl mx-auto px-4 py-12 sm:py-20">
    <a href={basePath + "/news"} class="inline-flex items-center text-sm text-gray-500 hover:text-blue-600 mb-8 transition-colors">
      &larr; Back to News
    </a>

    <header class="mb-10">
      <time class="block text-sm text-gray-500 mb-3">
        {item.data.date.toISOString().split('T')[0]}
      </time>
      <h1 class="page-title mb-6">{item.data.title}</h1>
      {item.data.summary && (
        <p class="text-xl text-gray-600 leading-relaxed">{item.data.summary}</p>
      )}
    </header>

    <div class="md-content max-w-none">
      <Content />
    </div>
  </article>
</Layout>