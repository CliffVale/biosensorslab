---
import Layout from '../layouts/Layout.astro';
import { ExternalLink, Database } from 'lucide-react';
import linksBanner from '../assets/branding/links-banner.jpg';

const links = [
  { name: 'Centre for Biomedical Engineering, IIT Delhi', url: 'https://cbme.iitd.ac.in/', desc: 'Department homepage' },
  { name: 'IIT Delhi', url: 'https://home.iitd.ac.in/', desc: 'Institute homepage' },
];
---

<Layout
  title="Important Links"
  description="Useful links and resources from the Biosensors & Devices Lab, IIT Delhi."
>
  <section class="py-14 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Important Links</h1>
      <p class="text-gray-600 mb-8">Useful resources, databases, and institutional links.</p>

      {false && (
        <div class="mb-8 rounded-2xl overflow-hidden border border-gray-100 shadow-sm">
          <img src={linksBanner.src} alt="Aptamer database banner" class="w-full h-auto" />
        </div>
      )}

      <div class="space-y-3">
        {links.map(l => (
          <a
            href={l.url}
            target={l.url.startsWith('http') ? '_blank' : undefined}
            rel="noopener noreferrer"
            class="group flex items-center justify-between bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all px-5 py-4"
          >
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
                <Database className="w-5 h-5 text-blue-700" />
              </div>
              <div>
                <p class="font-medium text-gray-900 group-hover:text-blue-700">{l.name}</p>
                <p class="text-sm text-gray-500">{l.desc}</p>
              </div>
            </div>
            <ExternalLink className="w-4 h-4 text-gray-400 group-hover:text-blue-700" />
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
