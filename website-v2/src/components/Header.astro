---
import { SITE, LOGO_IMAGE } from '../config';
import labLogo from '../assets/branding/logo-lab-72.webp';
import {
  Menu, X, ChevronRight,
  Home, BookOpen, FileText, FlaskConical, Users, Newspaper, UserPlus, Search,
  User, Landmark, GraduationCap, Camera, ExternalLink, Phone, BadgeCheck
} from 'lucide-react';

const { nav, customPages } = SITE;

const iconMap: Record<string, any> = {
  home: Home,
  research: BookOpen,
  pi: User,
  publications: FileText,
  patents: BadgeCheck,
  equipment: FlaskConical,
  team: Users,
  funding: Landmark,
  courses: GraduationCap,
  gallery: Camera,
  news: Newspaper,
  links: ExternalLink,
  contact: Phone,
  join: UserPlus,
  search: Search,
};

const getIcon = (key: string) => iconMap[key] || Search;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Active nav detection (pathname includes the base path, e.g. /biosensorslab/research)
const pathname = Astro.url.pathname;
const isActive = (link: string) => {
  if (link === '/') return pathname === baseUrl + '/' || pathname === baseUrl;
  return pathname.startsWith(baseUrl + link);
};
---

<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-gray-100 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo & Name -->
      <div class="flex items-center gap-3">
        <a href={baseUrl + "/"} class="flex items-center gap-2 group">
          {LOGO_IMAGE.enable && <img src={labLogo.src} alt="Biosensors & Devices Lab" width="36" height="36" class="h-9 w-9 object-contain" />}
          <div class="flex flex-col sm:flex-row sm:items-end sm:gap-2 leading-tight">
            <span class="font-bold text-gray-900 text-lg leading-tight group-hover:text-blue-600 transition-colors">
              {SITE.labName}
            </span>
            <span class="hidden sm:inline text-gray-500 text-sm font-light pb-0.5">
              {SITE.university}
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex gap-5 items-center">
        {nav.map(item => {
          if (item.key === 'search') {
            const Icon = getIcon(item.key);
            return (
              <a
                href={baseUrl + item.link}
                class="p-2 text-gray-600 hover:text-blue-600 hover:bg-gray-50 rounded-full transition-colors"
                aria-label={item.text}
              >
                <Icon className="w-5 h-5" />
              </a>
            );
          }
          return (
            <a
              href={baseUrl + item.link}
              class:list={[
                'nav-link text-sm font-medium transition-colors',
                isActive(item.link)
                  ? 'text-blue-600 font-semibold'
                  : 'text-gray-600 hover:text-blue-600'
              ]}
              aria-current={isActive(item.link) ? 'page' : undefined}
            >
              {item.text}
            </a>
          );
        })}

        {customPages && customPages.map(item => (
          <a
            href={baseUrl + item.link}
            class:list={[
              'nav-link text-sm font-medium transition-colors',
              isActive(item.link)
                ? 'text-blue-600 font-semibold'
                : 'text-gray-600 hover:text-blue-600'
            ]}
            aria-current={isActive(item.link) ? 'page' : undefined}
          >
            {item.text}
          </a>
        ))}
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 -mr-2 text-gray-600 hover:bg-gray-100 rounded-lg transition-colors z-[80] relative"
        aria-label="Toggle menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        onclick="window.toggleMobileMenu(event)"
      >
        <span class="icon-menu block transition-transform duration-300">
          <Menu className="w-6 h-6" />
        </span>
        <span class="icon-close hidden absolute inset-0 flex items-center justify-center transition-transform duration-300 rotate-90">
          <X className="w-6 h-6" />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Nav Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-[100] w-screen h-screen bg-white lg:hidden hidden flex-col"
    style="display: none;"
    role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="mobile-menu-title"
  >
    <div class="flex items-center justify-between px-6 h-20 border-b border-gray-100 shrink-0 bg-white">
      <div class="flex items-center gap-3">
        {LOGO_IMAGE.enable && <img src={labLogo.src} alt="Biosensors & Devices Lab" width="40" height="40" class="h-10 w-10 object-contain" />}
        <span class="font-bold text-gray-900 text-xl">{SITE.labName}</span>
      </div>
      <button
        onclick="window.closeMobileMenu()"
        class="p-2 -mr-2 rounded-full text-gray-600 hover:bg-gray-100 transition-colors"
        aria-label="Close menu"
      >
        <X className="w-8 h-8" />
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-6 py-8 flex flex-col gap-2 bg-white">
      {nav.map((item) => (
        <a
          href={baseUrl + item.link}
          class:list={[
            'flex items-center justify-between w-full py-4 px-4 text-lg font-medium rounded-xl transition-all border-b border-gray-100 last:border-0',
            isActive(item.link)
              ? 'text-blue-700 bg-blue-50'
              : 'text-gray-800 hover:text-blue-600 hover:bg-gray-50'
          ]}
          onclick="window.closeMobileMenu()"
        >
          <span>{item.text}</span>
          <ChevronRight className="w-5 h-5 text-gray-400" />
        </a>
      ))}

      {customPages && customPages.map((item) => (
        <a
          href={baseUrl + item.link}
          class:list={[
            'flex items-center justify-between w-full py-4 px-4 text-lg font-medium rounded-xl transition-all border-b border-gray-100 last:border-0',
            isActive(item.link)
              ? 'text-blue-700 bg-blue-50'
              : 'text-gray-800 hover:text-blue-600 hover:bg-gray-50'
          ]}
          onclick="window.closeMobileMenu()"
        >
          <span>{item.text}</span>
          <ChevronRight className="w-5 h-5 text-gray-400" />
        </a>
      ))}
    </nav>

    <div class="p-8 bg-gray-50 shrink-0 border-t border-gray-200">
      <p class="text-sm text-gray-500 font-medium text-center">© {new Date().getFullYear()} {SITE.labName}</p>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconMenu = document.querySelector('.icon-menu');
    const iconClose = document.querySelector('.icon-close');

    let lastFocusedEl = null;

    function setAria(open) {
      btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      menu?.setAttribute('aria-hidden', open ? 'false' : 'true');
    }

    function trapFocus(e) {
      if (!menu || !menu.contains(document.activeElement)) return;
      if (e.key !== 'Tab') return;
      const focusable = menu.querySelectorAll('a, button, input, [tabindex]:not([tabindex="-1"])');
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function onKeydown(e) {
      if (e.key === 'Escape') {
        window.closeMobileMenu();
      } else {
        trapFocus(e);
      }
    }

    function openMenu() {
      if (menu) {
        menu.style.display = 'flex';
        menu.offsetHeight;
        menu.classList.remove('hidden');

        // Smooth fade + slide in
        menu.animate([
          { opacity: 0, transform: 'translateY(8px)' },
          { opacity: 1, transform: 'translateY(0)' }
        ], {
          duration: 250,
          fill: 'forwards',
          easing: 'cubic-bezier(0.23, 1, 0.32, 1)'
        });

        // Staggered link entrance
        const links = menu.querySelectorAll('nav a');
        links.forEach((link, i) => {
          link.animate([
            { opacity: 0, transform: 'translateX(-12px)' },
            { opacity: 1, transform: 'translateX(0)' }
          ], {
            duration: 300,
            delay: 50 + i * 30,
            fill: 'forwards',
            easing: 'cubic-bezier(0.23, 1, 0.32, 1)'
          });
        });
      }

      iconMenu?.classList.add('rotate-90', 'opacity-0');
      iconClose?.classList.remove('hidden', 'rotate-90');

      document.body.classList.add('overflow-hidden');
      setAria(true);

      lastFocusedEl = document.activeElement;
      const firstLink = menu?.querySelector('a');
      firstLink?.focus?.();

      document.addEventListener('keydown', onKeydown);
    }

    window.closeMobileMenu = function() {
      if (menu) {
        const animation = menu.animate([
          { opacity: 1, transform: 'translateY(0)' },
          { opacity: 0, transform: 'translateY(8px)' }
        ], {
          duration: 200,
          fill: 'forwards',
          easing: 'cubic-bezier(0.77, 0, 0.175, 1)'
        });

        animation.onfinish = () => {
          menu.style.display = 'none';
          menu.classList.add('hidden');
          // Reset link animations for next open
          const links = menu.querySelectorAll('nav a');
          links.forEach(link => {
            link.getAnimations().forEach(a => a.cancel());
          });
        };
      }

      iconMenu?.classList.remove('rotate-90', 'opacity-0');
      iconClose?.classList.add('rotate-90');
      setTimeout(() => {
        iconClose?.classList.add('hidden');
      }, 200);

      document.body.classList.remove('overflow-hidden');
      setAria(false);

      document.removeEventListener('keydown', onKeydown);
      if (lastFocusedEl && typeof lastFocusedEl.focus === 'function') {
        lastFocusedEl.focus();
      } else {
        btn?.focus?.();
      }
    };

    window.toggleMobileMenu = function(e) {
      if (e) e.stopPropagation();
      if (!menu) return;
      const isHidden = menu.style.display === 'none' || menu.classList.contains('hidden');
      if (isHidden) openMenu();
      else window.closeMobileMenu();
    };

    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', window.closeMobileMenu);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) window.closeMobileMenu();
    });
  })();
</script>